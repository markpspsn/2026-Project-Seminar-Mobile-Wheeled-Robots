Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Time
    Name: Time
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 14
      Color: 140; 140; 140
      Alpha: 0.3
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Alpha: 0.8
      Draw Behind: true
      Topic:
        Value: /map
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /scan
        Depth: 10
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Color Transformer: FlatColor
      Color: 255; 0; 0
      Style: Flat Squares
      Size (m): 0.02
      Decay Time: 0
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: AMCL pose
      Enabled: true
      Topic:
        Value: /amcl_pose
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Shape: Arrow
      Color: 255; 140; 0
      Shaft Length: 0.4
      Head Length: 0.15
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 0.4
      Show Names: true
      Frames:
        All Enabled: false
        map:
          Value: true
        base_link:
          Value: true
        base_link_gt:
          Value: true
    - Class: nav2_rviz_plugins/ParticleCloud
      Name: ParticleCloud
      Enabled: true
      Color: 0; 80; 255
      Shape: Arrow (Flat)
      Min Arrow Length: 0.02
      Max Arrow Length: 0.12
      Topic:
        Value: /particle_cloud
        Depth: 5
        Reliability Policy: Best Effort
        Durability Policy: Volatile
  Global Options:
    Fixed Frame: map
    Background Color: 48; 48; 48
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Target Frame: map
      Scale: 85
      Angle: 0
      X: 0
      Y: 0
Window Geometry:
  Width: 1280
  Height: 850
  X: 50
  Y: 50
  Hide Right Dock: true
  QMainWindow State: 
